{
  "_comment": "取得する指標の定義。source=yfinance は ticker、source=fred は FRED の series_id。transform: none / yoy(前年同月比%) / diff(前期差)。polarity: 1=上昇が好材料, -1=上昇が悪材料, 0=中立（前日比の色分けに使用）",
  "groups": [
    { "id": "jp_equity", "name": "日本株", "items": ["n225", "topix_etf"] },
    { "id": "fx_rates", "name": "為替・金利", "items": ["usdjpy", "eurjpy", "jp10y", "us10y", "gold"] },
    { "id": "commodity_energy", "name": "エネルギー先物（燃料・肥料コスト）", "items": ["wti", "brent", "heating_oil", "natgas"] },
    { "id": "commodity_grain", "name": "穀物先物（CBOT）", "items": ["corn", "soybean", "wheat", "soymeal", "rice"] },
    { "id": "us_equity", "name": "米国株", "items": ["sp500", "nasdaq", "dow", "vix"] },
    { "id": "macro_us", "name": "米国マクロ", "items": ["us_cpi", "us_unrate", "us_ffr", "us_payrolls", "us_gdp", "us_t10y2y"] },
    { "id": "macro_jp", "name": "日本マクロ", "items": ["jp_cpi", "jp_unrate", "jp_callrate"] }
  ],
  "indicators": {
    "n225":        { "name": "日経平均",          "source": "yfinance", "ticker": "^N225",    "unit": "円",   "decimals": 0, "polarity": 1 },
